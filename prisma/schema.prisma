generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?
  image            String?
  plan             Plan            @default(free)
  stripeCustomerId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  accounts         Account[]
  expenseProfile   ExpenseProfile?
  goals            Goal[]
  sessions         Session[]
  subscription     Subscription?
}

model ExpenseProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  rent      Int      @default(0)
  groceries Int      @default(0)
  food      Int      @default(0)
  transport Int      @default(0)
  utilities Int      @default(0)
  other     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String         @id @default(cuid())
  userId       String
  targetAmount Int
  startDate    DateTime       @default(now())
  deadline     DateTime
  status       GoalStatus     @default(active)
  savedAmount  Int            @default(0)
  rewardRate   Float?
  rewardAmount Int?
  settledAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      SavingsEntry[]

  @@index([userId, status])
  @@index([status, deadline])
}

model SavingsEntry {
  id        String   @id @default(cuid())
  goalId    String
  amount    Int
  note      String?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Plan {
  free
  premium
}

enum GoalStatus {
  active
  completed
  failed
  cancelled
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}
